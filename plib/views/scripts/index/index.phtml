<h1>Tabularis</h1>
<p>Open an authorized MySQL, MariaDB or PostgreSQL database in a new tab. Your Plesk session controls access.</p>
<?php if (!$this->configured): ?>
<p role="status">An administrator must configure the pinned Tabularis runtime before workspaces can be opened.</p>
<?php elseif ($this->catalogError): ?>
<p role="alert">Database permissions could not be verified. Contact your Plesk administrator.</p>
<?php elseif (!$this->databases): ?>
<p role="status">No accessible databases are available.</p>
<?php else: ?>
<table class="list">
    <caption>Your accessible databases</caption>
    <thead><tr><th scope="col">Domain</th><th scope="col">Database</th><th scope="col">Engine</th><th scope="col">Action</th></tr></thead>
    <tbody>
    <?php foreach ($this->databases as $database): ?>
        <tr>
            <td><?= $this->escape($database['domain']) ?></td>
            <td><?= $this->escape($database['name']) ?></td>
            <td><?= $database['driver'] === 'postgres' ? 'PostgreSQL' : 'MySQL / MariaDB' ?></td>
            <td><a href="/tabularis/open/<?= (int) $database['id'] ?>" target="_blank" rel="noopener noreferrer"
                aria-label="<?= $this->escape('Open ' . $database['name'] . ' in Tabularis (new tab)') ?>">Open in Tabularis ↗</a></td>
        </tr>
    <?php endforeach; ?>
    </tbody>
</table>
<?php endif; ?>
